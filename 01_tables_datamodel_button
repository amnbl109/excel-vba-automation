Option Explicit


Sub Tables_DataModel_Button()

    Dim wb As Workbook
    Dim ws As Worksheet
    Dim pivotWS As Worksheet
    
    Dim lastRow As Long, lastCol As Long
    Dim dataRange As Range
    Dim tbl As ListObject
    Dim obj As ListObject
    Dim alreadyTable As Boolean
    
    Dim sheetSafeName As String
    Dim tblName As String
    Dim connName As String
    
    Dim btn As Shape
    Dim leftPos As Double, topPos As Double
    Dim widthVal As Double, heightVal As Double

    Set wb = ActiveWorkbook

    Application.ScreenUpdating = False
    Application.DisplayAlerts = False

    '=====================================
    ' PART 1: Tables + Data Model Load
    '=====================================
    For Each ws In wb.Worksheets

        ' Skip Pivot_Structure (handled later)
        If ws.Name = "Pivot_Structure" Then GoTo NextSheet

        ' Skip empty sheets
        If Application.WorksheetFunction.CountA(ws.Cells) = 0 Then GoTo NextSheet

        ' Detect data range
        On Error Resume Next
        lastRow = ws.Cells.Find("*", SearchOrder:=xlByRows, SearchDirection:=xlPrevious).Row
        lastCol = ws.Cells.Find("*", SearchOrder:=xlByColumns, SearchDirection:=xlPrevious).Column
        On Error GoTo 0

        If lastRow = 0 Or lastCol = 0 Then GoTo NextSheet

        Set dataRange = ws.Range(ws.Cells(1, 1), ws.Cells(lastRow, lastCol))

        ' Check if already a table
        alreadyTable = False
        For Each obj In ws.ListObjects
            If Not Intersect(obj.Range, dataRange) Is Nothing Then
                alreadyTable = True
                Set tbl = obj
                Exit For
            End If
        Next obj

        ' Create table if needed
        If Not alreadyTable Then
            Set tbl = ws.ListObjects.Add(xlSrcRange, dataRange, , xlYes)
        End If

        ' Clean table name
        sheetSafeName = ws.Name
        sheetSafeName = Replace(sheetSafeName, " ", "_")
        sheetSafeName = Replace(sheetSafeName, "-", "_")
        sheetSafeName = Replace(sheetSafeName, ".", "_")

        tblName = "tbl_" & sheetSafeName

        On Error Resume Next
        tbl.Name = tblName
        If Err.Number <> 0 Then
            Err.Clear
            tbl.Name = tblName & "_" & Format(Now, "hhmmss")
        End If
        On Error GoTo 0

        ' Create connection & load to Data Model
        connName = "conn_" & tbl.Name

        On Error Resume Next
        wb.Connections(connName).Delete
        On Error GoTo 0

        wb.Connections.Add2 _
            Name:=connName, _
            Description:="Connection for " & tbl.Name, _
            ConnectionString:="WORKSHEET;" & wb.FullName, _
            CommandText:=tbl.Name, _
            lCmdtype:=xlCmdExcel, _
            CreateModelConnection:=True, _
            ImportRelationships:=False

NextSheet:
        Set tbl = Nothing

    Next ws

    '=====================================
    ' PART 2: Pivot_Structure + Button
    '=====================================

    ' Check if Pivot_Structure exists
    On Error Resume Next
    Set pivotWS = wb.Sheets("Pivot_Structure")
    On Error GoTo 0

    ' Create if not exists
    If pivotWS Is Nothing Then
        Set pivotWS = wb.Sheets.Add
        pivotWS.Name = "Pivot_Structure"
    End If

    ' Remove existing buttons
    For Each btn In pivotWS.Shapes
        btn.Delete
    Next btn

    ' Define button position
    leftPos = pivotWS.Range("M2").Left
    topPos = pivotWS.Range("M2").Top
    widthVal = pivotWS.Range("M2:O2").Width
    heightVal = pivotWS.Range("M2:O4").Height

    ' Add button
    Set btn = pivotWS.Shapes.AddFormControl(xlButtonControl, leftPos, topPos, widthVal, heightVal)

    With btn
        .TextFrame.Characters.Text = "Pivot Tables"
        .OnAction = "Create_Multiple_Pivots"
    End With

    '=====================================
    ' Finish
    '=====================================
    Application.ScreenUpdating = True
    Application.DisplayAlerts = True

    MsgBox "Tables created, Data Model loaded, and Pivot button added!", vbInformation

End Sub
